# ==============================================================================
# UnlockED - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# Public App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=UnlockED

# Google Gemini AI (Private - Server Only)
# Get your API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Supabase Public API (Client + Server with RLS)
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Private - Server Only - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Bootstrap Secret (Minimum 16 chars - Private - Server Only)
# ADMIN_INIT_SECRET=replace_with_strong_random_secret_min_16_chars

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
